# Copy this file to your actual environment variable source before testing sandbox payments.
# Example: set these values in your local server environment or load them via your .env loader.
# Do not put real production secrets here.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=pms_db
APP_BASE_URL=http://localhost/parlour

KHALTI_SANDBOX_KEY=your_khalti_sandbox_key_here
ESEWA_SANDBOX_MERCHANT_CODE=EPAYTEST
ESEWA_SANDBOX_MERCHANT_SECRET=your_esewa_sandbox_secret_here

# Notes:
# - DB_* values are used for a hosted or local MySQL connection.
# - APP_BASE_URL should match your public site URL when deployed.
# - KHALTI_SANDBOX_KEY is used for the Khalti sandbox initiate API.
# - ESEWA_SANDBOX_MERCHANT_CODE is used for the eSewa test payment form.
# - Keep this file out of version control if you are storing real keys.
